# 줄바꿈은 저장소에 LF로 통일하고 체크아웃 시 OS에 맞춘다
* text=auto

# Unity YAML — 텍스트로 다뤄야 diff·병합이 된다
*.unity     text eol=lf
*.asset     text eol=lf
*.prefab    text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.meta      text eol=lf
*.cs        text eol=lf diff=csharp

# 바이너리 — diff 시도 금지
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.ttf       binary
*.otf       binary
*.fbx       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.dll       binary
*.so        binary
